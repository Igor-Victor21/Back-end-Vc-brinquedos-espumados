// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model userInfo{
  id Int @id @default(autoincrement())
  fullName String 
  email String @unique
  password String
  cpf String 
  socialReason String 
  stateRegistration String 
  cnpj String
  cep String 
  uf String
  city String
  neighborhood String
  road String
  numberHouse Int
  complement String
  numberPhone String
  dateOfBirth String
}

model Products{
  id Int @id @default(autoincrement())
  name String
  description String
  measures String
  price Float
  image String
}

